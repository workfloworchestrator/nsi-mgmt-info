#
# AMISS environment settings
#
#SITE_TITLE="AMISS - Demo"

# host and port to bind to
#NSI_AMISS_HOST=127.0.0.1
#NSI_AMISS_PORT=8000

# certificate and key to authenticate against the ANA-NSI proxies (mutual TLS)
#NSI_AMISS_CERTIFICATE="amiss-certificate.pem"
#NSI_AMISS_PRIVATE_KEY="amiss-private-key.pem"

# PEM file or c_rehash directory of CA certificates to verify the proxies.
# Rehash a directory with: openssl rehash .
# When unset the default Python requests module CA bundle is used.
#CA_CERTIFICATES=

# requests certificate verification, only disable while debugging!
#VERIFY_REQUESTS=True

# database URI, supported schemes are sqlite and postgresql.
# Default is an ephemeral shared in-memory SQLite database.
#DATABASE_URI="sqlite:///db/amiss.db"

# seed dummy reservations and segments at startup (dev/demo only)
#SEED_DUMMY_SEGMENTS_DATA=False

# directory containing static files, such as images
#STATIC_DIRECTORY="static"

# data sources
#NSI_DDS_PROXY_URL="http://dds.domain.example/dds/"
#NSI_AGG_PROXY_URL="http://aggregator-proxy.domain.example/"
#NSI_AMISS_WFO_URL="http://orchestrator.domain.example/mgmt"

# Logging
#SQL_LOGGING=False
#LOG_LEVEL="INFO"

# ASGI root path prefix. Set when behind a reverse proxy that strips a path prefix.
#ROOT_PATH=
